SYNC_DOMAIN=sync.example.com

STS_PROVIDER=aliyun
ALIYUN_ACCESS_KEY_ID=replace_on_server
ALIYUN_ACCESS_KEY_SECRET=replace_on_server
ALIYUN_STS_ROLE_ARN=replace_on_server
STS_DURATION_SECONDS=3600

OSS_BUCKET=replace_on_server
OSS_REGION=cn-hangzhou
OSS_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com

TOKEN_SALT=replace_with_independent_random_value
DEVICE_SALT=replace_with_another_independent_random_value
RATE_LIMIT_PER_MINUTE=60
