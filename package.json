{
  "name": "obsidian-sync-plugin",
  "version": "0.1.4",
  "description": "Cross-device sync plugin for Obsidian with end-to-end encryption",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "mock:sts": "node scripts/mock-sts-server.mjs",
    "server:commercial-sts": "node scripts/commercial-sts-server.mjs",
    "admin:commercial-sts": "node scripts/commercial-sts-admin.mjs",
    "policy:oss-sts": "node scripts/aliyun-oss-sts-policy.mjs",
    "preflight:commercial-sts": "node scripts/commercial-sts-preflight.mjs",
    "check:commercial-sts": "node scripts/commercial-sts-endpoint-check.mjs",
    "smoke:aliyun-sts": "node scripts/aliyun-sts-smoke.mjs",
    "smoke:aliyun-oss-sts": "node scripts/aliyun-oss-sts-smoke.mjs",
    "package": "npm run build && node scripts/package-plugin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1065.0"
  }
}
